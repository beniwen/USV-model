% 系统动力学函数
function [dx, y] = vehicle_dynamics(t, x, tau,m1, m2, m3, m4
    % 参数
    m1 = 1; m2 = 1; m3 = 1; m4 = 1; % 质量矩阵元素（待辨识）
    % 状态变量
    u = x(1); v = x(2); p = x(3); r = x(4);

    % 动力学模型（四自由度）
    dx = zeros(4,1);
    dx(1) = m1 * tau(1) - m2 * v * r;
    dx(2) = m3 * tau(2) - m4 * u * r;
    dx(3) = m1 * tau(3) - m2 * v * p;
    dx(4) = m3 * tau(4) - m4 * u * p;

    % 输出
    y = [u; v; p; r];
end